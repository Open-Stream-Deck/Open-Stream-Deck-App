{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "plugin-settings",
  "description": "Plugin settings windows: no event emit, messages go through plugin_settings_up",
  "windows": ["plugin-settings-*"],
  "permissions": [
    "core:path:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:image:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "opener:default",
    "dialog:default"
  ]
}
